{
  "name": "rspress-beta",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.4.4",
  "scripts": {
    "build": "bun run clean && rspress build",
    "clean": "rm -rf doc_build docs/openapi",
    "dev": "rspress dev",
    "preview": "rspress preview",
    "test": "bun test",
    "format": "biome lint --write && bun fmt",
    "typecheck": "bun check",
    "lint:ts": "biome ci",
    "lint:format": "bun fmt --check",
    "lint:openapi": "vacuum lint --ruleset vacuum-rules.yaml --ignore-file ./vacuum-ignore.yaml --details ./docs/public/openapi.yaml",
    "lint": "bun run typecheck && bun run lint:ts && bun run lint:format && bun run lint:openapi"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@biomejs/biome": "2.6.3",
    "@quobix/vacuum": "0.35.2",
    "@rspress/core": "2.0.23",
    "@rspress/plugin-rss": "2.0.23",
    "@rspress/plugin-sitemap": "2.0.23",
    "@scalar/api-reference-react": "0.9.83",
    "@tsconfig/bun": "1.0.11",
    "@types/bun": "1.4.4",
    "micromark": "4.0.3",
    "openapi-types": "12.1.3",
    "rsbuild-plugin-open-graph": "1.1.3",
    "rspress-language-tabs": "1.1.0",
    "rspress-plugin-font-figtree": "1.0.1"
  },
  "trustedDependencies": [
    "@quobix/vacuum"
  ]
}
